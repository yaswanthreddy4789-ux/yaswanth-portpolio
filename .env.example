# Copy to .env.local for local development. NEVER commit real values.
# On Vercel add these under Project → Settings → Environment Variables.

# Public site URL (used for canonical links, sitemap, Open Graph). Set once you have a final domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# URL of your separate services website (leave empty until it is live). "Hire me" and case-study
# buttons then open it, and the old /services URLs redirect to it.
NEXT_PUBLIC_SERVICES_URL=
