# Copy to .env.local for local development. NEVER commit real values.
# On Vercel add these under Project → Settings → Environment Variables.

# Public site URL (used for canonical links, sitemap, Open Graph). Set once you have a final domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Quote form delivery. Works with NO setup via the FormSubmit relay (click the one-time activation email).
# For best deliverability add a Resend key (https://resend.com). Server-side only; never commit real values.
RESEND_API_KEY=
CONTACT_TO_EMAIL=yaswanthreddy4789@gmail.com
# Optional. Must be a sender/domain verified in Resend. Defaults to Resend's onboarding sender.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
