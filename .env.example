# Copy to .env.local for local development. NEVER commit real values.
# On Vercel add these under Project → Settings → Environment Variables.

# Public site URL (used for canonical links, sitemap, Open Graph). Set once you have a final domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery via Resend (https://resend.com). Server-side only.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@yourdomain.com
# Optional. Must be a sender/domain verified in Resend. Defaults to Resend's onboarding sender.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
